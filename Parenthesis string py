class Solution(object):
    def minInsertions(self, s):
        """
        :type s: str
        :rtype: int
        """
        insertions = 0
        open_count = 0

        i = 0
        while i < len(s):
            if s[i] == '(':
                open_count += 1
            else:
                # Check whether the next character is ')'
                if i + 1 < len(s) and s[i + 1] == ')':
                    i += 1
                else:
                    insertions += 1

                # One opening bracket needs two closing brackets
                if open_count > 0:
                    open_count -= 1
                else:
                    # Insert one opening bracket
                    insertions += 1

            i += 1

        # Each remaining '(' needs two ')'
        insertions += open_count * 2

        return insertions
        
